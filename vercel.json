{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www\\.transistemas\\.org" }],
      "destination": "https://transistemas.org/:path",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/markdown/index.md"
    },
    {
      "source": "/cursos",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/markdown/cursos.md"
    },
    {
      "source": "/cursos/:slug",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/markdown/cursos/:slug.md"
    },
    {
      "source": "/equipos",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/markdown/equipos.md"
    },
    {
      "source": "/hormonizacion",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/markdown/hormonizacion.md"
    },
    {
      "source": "/hormonizacion/:slug",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/markdown/hormonizacion/:slug.md"
    },
    {
      "source": "/about",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/markdown/about.md"
    },
    {
      "source": "/contact",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/markdown/contact.md"
    },
    {
      "source": "/privacy",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/markdown/privacy.md"
    },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/cursos", "destination": "/index.html" },
    { "source": "/cursos/:slug", "destination": "/index.html" },
    { "source": "/equipos", "destination": "/index.html" },
    { "source": "/hormonizacion", "destination": "/index.html" },
    { "source": "/hormonizacion/embed", "destination": "/index.html" },
    { "source": "/hormonizacion/:slug", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/cursos",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/cursos/:slug",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/equipos",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/hormonizacion",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/hormonizacion/:slug",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/about",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/contact",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/privacy",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/markdown/:path*",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    }
  ]
}
